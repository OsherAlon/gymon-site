---
import BlogLayout from '@/layouts/BlogLayout.astro';
import { BlogSection } from '@/components/ui/blog-section';
import { listing, articleUrl, blogCopy, formatDate } from '@/lib/blog';
import type { Lang } from '@/lib/source';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = blogCopy(lang);
const list = await listing(lang);
const blogs = list.map((a) => ({
  title: a.title,
  slug: articleUrl(lang, a.slug),
  description: a.description,
  image: a.image,
  createdAt: formatDate(lang, a.date),
  author: a.author,
  readTime: t.readTime(a.readTime),
}));
// While the blog only holds placeholder articles (mock / preview / sample), keep it out of search results.
const onlyMock = list.length > 0 && list.every((a) => a.placeholder);
---
<BlogLayout lang={lang} page="blog" title={`${t.title} · Gymon`} description={t.subheading} noindex={onlyMock}>
  {/* Hydrated only for the image fade-in; every word is in the server HTML. */}
  <BlogSection client:load blogs={blogs} heading={t.heading} subheading={t.subheading} byLabel={t.by} />
  {list.length === 0 && <p class="text-muted-foreground mx-auto max-w-5xl px-6">{t.empty}</p>}
</BlogLayout>
