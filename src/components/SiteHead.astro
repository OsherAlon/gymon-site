---
/**
 * The <head> every page shares — ported from the old `build.mjs` layout.
 *
 * English sits at the fixed URLs (/privacy, /terms, /support) and Hebrew under
 * /he/. A visitor whose device is Hebrew is sent to /he/ unless they chose a
 * language here before — so the one URL the app and App Store Connect hold
 * serves both languages, while the HTML at every URL stays complete.
 */
import { COMMIT, DOMAIN, LANGS, type Lang } from '@/lib/source';
import { urlFor, type Page } from '@/lib/legal';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  /** 404: no canonical/alternates and no redirect (Pages serves it for any path). */
  notFound?: boolean;
  /** Languages this page exists in (an article may lack a translation). */
  langs?: readonly Lang[];
  description?: string;
  noindex?: boolean;
}

const { lang, page, title, notFound = false, langs = LANGS, description, noindex = false } = Astro.props;
const redirect =
  "try{var s=localStorage.getItem('lang');if(s==='he'||(!s&&/^(he|iw)\\b/i.test(navigator.language||'')))location.replace('/he'+location.pathname.replace(/\\/$/,'')+location.hash)}catch(e){}";
// The device-language redirect runs on the App Store pages (/, /privacy, /terms,
// /support) only — never on the blog, where an English article may be what was
// shared or searched. English articles show a dismissible "also in Hebrew" bar instead.
const isBlog = page === 'blog' || page.startsWith('blog/');
const hasRedirect = !notFound && !isBlog && lang === 'en' && langs.includes('he');
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="source-commit" content={COMMIT}>
<meta name="color-scheme" content="light">
{description && <meta name="description" content={description}>}
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" href="data:,">
{!notFound && <link rel="canonical" href={`https://${DOMAIN}${urlFor(lang, page)}`}>}
{!notFound && langs.length > 1 && langs.map((l) => <link rel="alternate" hreflang={l} href={`https://${DOMAIN}${urlFor(l, page)}`}>)}
{!notFound && langs.length > 1 && <link rel="alternate" hreflang="x-default" href={`https://${DOMAIN}${urlFor('en', page)}`}>}
{hasRedirect && <script is:inline set:html={redirect}></script>}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Epilogue:wght@400;600;700&display=swap">
<slot />
