---
/**
 * One card of the home marquee — adapted from the user-supplied testimonial-card.tsx:
 * same gradient (from-muted/50 to-muted/10), border-t, max-w 320px; the avatar becomes a small
 * line icon, name → title, handle → tag. Data-driven: a real, permitted testimonial can fill the
 * same slots later (icon → photo, title → name, tag → handle).
 */
interface Props {
  icon: string;
  title: string;
  tag: string;
  text: string;
}
const { icon, title, tag, text } = Astro.props;

// 24×24 stroke icons (lucide-style geometry, inline so nothing is installed or loaded).
const paths: Record<string, string> = {
  plan: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 14h.01M12 14h.01M16 14h.01',
  log: 'M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9',
  timer: 'M10 2h4M12 14l3-3M12 22a8 8 0 1 0 0-16 8 8 0 0 0 0 16z',
  chat: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  trend: 'M3 3v18h18M7 15l4-4 3 3 6-6',
  lang: 'M5 8l6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6',
  book: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5',
  health: 'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z',
};
const d = paths[icon] ?? paths.plan;
---
<article class="from-muted/50 to-muted/10 flex w-[17rem] max-w-[320px] shrink-0 flex-col rounded-lg border-t bg-gradient-to-b p-4 text-start sm:w-[20rem] sm:p-6">
  <div class="flex items-center gap-3">
    <span class="bg-card text-brand flex size-11 shrink-0 items-center justify-center rounded-full border" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={d} /></svg>
    </span>
    <div class="flex flex-col items-start">
      <h3 class="text-base leading-tight font-semibold">{title}</h3>
      <p class="text-muted-foreground text-sm">{tag}</p>
    </div>
  </div>
  <p class="text-muted-foreground mt-4 text-sm leading-relaxed sm:text-base">{text}</p>
</article>
