---
/**
 * Home page (/ and /he/). Was the plain LegacyLayout list; now a Tailwind page on a white
 * ground whose opening is row 1 of the zigzag showcase (user decisions 2026-10-07). Same headline, tagline and
 * the same four links (privacy, terms, support, blog). The legal pages keep LegacyLayout.
 */
import BlogLayout from '@/layouts/BlogLayout.astro';
import FeatureMarquee from '@/components/ui/FeatureMarquee.astro';
import ZigzagShowcase from '@/components/ui/zigzag-showcase';
import CinematicHero from '@/components/ui/cinematic-hero';
import { APP_STORE_URL } from '../copy.mjs';
import { copy } from '../copy.mjs';
import { urlFor } from '@/lib/legal';
import type { Lang } from '@/lib/source';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (copy as any)[lang];
const rows = t.showcase.map((r: any) => ({ tag: r.tag, title: r.title, text: r.text, alt: r.alt, src: `/app/screen-${r.key}-${lang}.webp` }));
const c = t.cinematic;
const links = (['privacy', 'terms', 'support', 'blog', 'pricing'] as const).map((p) => ({ href: urlFor(lang, p), label: t.nav[p] }));
---
<BlogLayout lang={lang} page="index" title="Gymon" description={t.home.tagline}>
  <div class="home-v2">
    {/* The page opens with the cinematic hero: the only H1 ("Gymon" + the tagline), pinned scroll.
        client:load — it is the first thing on screen. Server-rendered either way. */}
    <CinematicHero
      client:load
      lang={lang}
      brandName={t.home.title}
      tagline1={t.home.title}
      tagline2={c.tagline2}
      cardHeading={c.cardHeading}
      cardDescription={t.home.tagline}
      screenSrc={`/app/screen-home-${lang}.webp`}
      screenAlt={t.home.screenAlt}
      badges={c.badges}
      ctaHeading={c.ctaHeading}
      ctaDescription={c.ctaDescription}
      ctaLink={{ href: urlFor(lang, 'pricing'), label: c.ctaLink }}
      appStoreHref={APP_STORE_URL}
      playSoon={t.playSoon}
    />
    {/* client:visible — the showcase now starts below the hero. Server-rendered. */}
    <ZigzagShowcase client:visible rows={rows} />
    <ul class="home-links mx-auto w-full max-w-md px-4">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <FeatureMarquee title={t.features.title} description={t.features.description} items={t.features.items} />
  </div>
</BlogLayout>
